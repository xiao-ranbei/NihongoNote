{
  "name": "@nihongonote/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "tsx scripts/verify-pipeline.ts",
    "regression": "tsx scripts/regression-corpus.ts",
    "dictionary-coverage": "tsx scripts/dictionary-coverage.ts",
    "dictionary-gap": "tsx scripts/dictionary-gap-analysis.ts",
    "calibrate": "tsx scripts/calibrate-output-model.ts",
    "build:jmdict-index": "tsx scripts/build-jmdict-index.ts",
    "gloss-smoke": "tsx scripts/gloss-translation-smoke.ts"
  },
  "dependencies": {
    "@nihongonote/core": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "kuromoji": "^0.1.2",
    "openai": "^7.8.0",
    "sql.js": "^1.13.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^22.10.7",
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
