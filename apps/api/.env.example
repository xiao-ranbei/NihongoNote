NIHONGO_HOST=127.0.0.1
NIHONGO_PORT=8787
NIHONGO_DATA_DIR=./data
# LLM 供应商：disabled | deepseek | openai | openai-compatible | ollama（本地模型）
# Ollama 示例：LLM_PROVIDER=ollama、LLM_BASE_URL=http://127.0.0.1:11434/v1、
#             LLM_MODEL=qwen3.5:9b（无需 LLM_API_KEY，余额不可用，预览费用显示「本地免费」）
LLM_PROVIDER=disabled
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=12000
LLM_TIMEOUT_MS=300000
LLM_PROMPT_VERSION=analysis-v3
LLM_THINKING_TYPE=enabled
LLM_REASONING_EFFORT=minimal
# 段级语义字段档位：minimal（翻译+语法）| standard（+语气礼貌合并+不确定性，默认）| full（7 字段全输出）
LLM_SEGMENT_FIELDS=standard
LLM_DEBUG_LOGGING=false
LLM_DEBUG_LOG_FILE=./data/llm-debug.jsonl
LLM_BATCH_SIZE=3
LLM_BATCH_CONCURRENCY=2
TTS_PROVIDER=disabled
TTS_VOICE=
TTS_SPEED=
TTS_FORMAT=
TTS_SSML_VERSION=
