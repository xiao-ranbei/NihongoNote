NIHONGO_HOST=127.0.0.1
NIHONGO_PORT=8787
NIHONGO_DATA_DIR=./data
# LLM 供应商：disabled | deepseek | openai | openai-compatible | ollama（本地模型）
# 设置页（docs/llm-settings-design.md）：.env 是初始默认；Web「设置」页保存后写入
# app_settings 表（db），db 有值的字段覆盖 .env；清空 db 设置即回到 .env 行为。
# 热切换：保存即重建 provider，无需重启。
# Ollama 示例：LLM_PROVIDER=ollama、LLM_BASE_URL=http://127.0.0.1:11434（可带 /v1，自动归一化）、
#             LLM_MODEL=qwen3.5:9b（无需 LLM_API_KEY，余额不可用，预览费用显示「本地免费」）
#             走 Ollama 原生 /api/chat（见 docs/analysis-tools-design.md §3.9：兼容层强制 num_ctx=4096
#             且无法关 thinking，故弃用）；输出预算自动压到 min(LLM_MAX_TOKENS, 8192)，
#             num_ctx 按预算+4096 设置（≈12288），保护 16GB VRAM 不 OOM
LLM_PROVIDER=disabled
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=12000
LLM_TIMEOUT_MS=300000
LLM_PROMPT_VERSION=analysis-v3
LLM_THINKING_TYPE=enabled
LLM_REASONING_EFFORT=minimal
# 段级语义字段档位：minimal（翻译+语法）| standard（+语气礼貌合并+不确定性，默认）| full（7 字段全输出）
LLM_SEGMENT_FIELDS=standard
LLM_DEBUG_LOGGING=false
LLM_DEBUG_LOG_FILE=./data/llm-debug.jsonl
LLM_BATCH_SIZE=3
LLM_BATCH_CONCURRENCY=2
TTS_PROVIDER=disabled
TTS_VOICE=
TTS_SPEED=
TTS_FORMAT=
TTS_SSML_VERSION=
